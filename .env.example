# Puertos locales en el host
WP_PORT=8080
PMA_PORT=8081
DB_PORT=3306

# Base de datos
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress_pass
DB_ROOT_PASSWORD=root_pass

# Credenciales para instalación automática de WordPress (opcional con bin/setup.sh)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.local
WP_SITE_TITLE="Segunda Ley - Pruebas Plugin"
